    "testing",
    "e2e",
    "daemon",
    "worker",
    "performance-testing",
    "developer-experience",
    "dev-ex",
    "dx"
  ],
  "author": "Olegzandr VD",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sumanjs/suman-daemon/issues"
  },
  "homepage": "https://github.com/sumanjs/suman-daemon#readme",
  "dependencies": {
    "@oresoftware/json-stream-parser": "latest",
    "forever": "^0.15.3",
    "poolio": "latest",
    "residence": "latest",
    "suman-utils": "latest"
  },
  "devDependencies": {
    "@types/node": "^6.0.81"
  },
  "oresLint": {
    "note": "Declared, not installed. ores-lint resolves these from a global install - see .ores-lint/README.md",
    "requires": {
      "eslint": ">=9",
